{
  "name": "wdi-method",
  "version": "0.6.28",
  "description": "The review layer for AI coding agents: human review gates that check technical decisions before Claude Code, Cursor, or Codex write the code. Wraps BMad.",
  "keywords": [
    "bmad",
    "bmad-method",
    "ai-coding",
    "coding-agents",
    "claude-code",
    "cursor",
    "codex",
    "spec-driven-development",
    "software-delivery",
    "code-review",
    "ai-governance",
    "agentic-workflow",
    "c4-model",
    "use-case",
    "documentation"
  ],
  "type": "module",
  "bin": {
    "wdi-method": "bin/wdi-method.js"
  },
  "files": [
    "bin/",
    "lib/",
    "kit/",
    "kit-overlay/",
    "scaffold/",
    "README.md",
    "README.id.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "README.es.md",
    "README.de.md",
    "README.fr.md",
    "README.pt-BR.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "node --test tests/*.test.mjs",
    "overlay": "node scripts/apply-overlay.mjs",
    "pretest": "node scripts/apply-overlay.mjs && node scripts/clean-kit.mjs",
    "prepack": "node scripts/clean-kit.mjs",
    "clean": "node scripts/clean-kit.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiradeltaid/wdi-method.git"
  },
  "bugs": {
    "url": "https://github.com/wiradeltaid/wdi-method/issues"
  },
  "homepage": "https://github.com/wiradeltaid/wdi-method#readme"
}
