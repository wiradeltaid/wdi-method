# .control/custom-dispatch.yaml.example
# Optional machine-local runner and dispatch configuration for autonomous daily tier skills.
# When seeded to `.control/custom-dispatch.yaml`, it remains local and gitignored.
schema: 1

runners: {}
# Uncomment and customize runners on this machine:
#
# NOTE: Every runner below may be named in roles.reviewer or roles.deep_analyst, and a reviewer
# runner MUST be read-only. The read-only flag per CLI: `--permission-mode plan` for claude,
# `--trust-tools=fs_read` for kiro-cli, `--mode plan` for cursor-agent. The examples all use it.
#
# Auto runners (dispatches in-session if model is reachable from active session;
# otherwise executes shell-out command):
# sonnet:
#   type: auto
#   model: sonnet
#   command: 'claude --model claude-sonnet-5 --effort high --permission-mode plan -p'
#
# opus:
#   type: auto
#   model: opus
#   command: 'claude --model claude-opus-5 --effort high --permission-mode plan -p'
#
# External CLI runners (always shell-out):
#
# terra:
#   type: shell-out
#   command: 'kiro-cli chat --model gpt-5.6-terra --effort high --trust-tools=fs_read --no-interactive'
#   timeout_s: 600   # Hard wall-clock timeout in seconds for backgrounded dispatch (default: 600s)
#
# composer:
#   type: shell-out
#   command: 'cursor-agent --mode plan --model "composer-2.5[fast=false]"'
#   timeout_s: 600
#
# sol:
#   type: shell-out
#   command: 'cursor-agent --mode plan --model "gpt-5.6-sol-high"'
#   timeout_s: 600

roles:
  # Builder configuration:
  #   builder is fixed to 'coordinator' (mandatory). The coordinating session implements code
  #   directly in the active run worktree (tight TDD cycles, direct verification). Coding delegation
  #   (in-session subagent or external builder runner) is prohibited in the daily routine to eliminate
  #   handoff latency and delegation hallucinations.
  #   Guardrail: builder: coordinator MUST NOT be paired with reviewer: none (or peer_review: false)
  #   when any touched component has risk_accepted: low. `low` is the hardest review: the code needs
  #   a two-reviewer panel of agents that are not the builder (delivery-flow-guide.md). When every
  #   touched component is medium or high, the bypass is allowed and the choice MUST be recorded.
  #   A builder cannot be its own sole judge.
  builder: coordinator

  # Reviewer options:
  #   - default: Resolves peer review via caller's active session / global agent rules
  #   - <runner-id>: Dispatches peer review to the named runner
  #   - none: Disables peer review pass (coordinator self-review only); refused at risk_accepted: low
  # NOTE: Reviewer runners in daily triage (wdi-daily-what-to-build) operate strictly as advisory /
  # read-only critics. The coordinator alone applies edits to the spec/tickets and writes registry traces.
  reviewer: default

  # Deep analyst options (for architecture spine, complex debugging, or hard decisions):
  #   - default: Uses reviewer runner or coordinator for deep analysis
  #   - <runner-id>: Dispatches deep analysis to a dedicated high-reasoning runner
  #   - none: Disables separate deep analyst dispatch (handled by reviewer/coordinator)
  deep_analyst: default

review_policy:
  peer_review: true        # Set to false (or set reviewer: none) to bypass peer review pass; not at risk_accepted: low
